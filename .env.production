# TS OPAC eLibrary - Production Environment Configuration
# Generated: January 5, 2026
# 
# IMPORTANT: Keep this file secure and never commit to git
# Store securely in production environment (e.g., CI/CD secrets, environment manager, etc.)
# Update sensitive values before deploying to production

# ============================================================================
# DJANGO CORE SETTINGS
# ============================================================================

# Django secret key (50+ characters, cryptographically secure)
# IMPORTANT: This MUST be changed for actual production deployment
SECRET_KEY=t6=&b3)whb#ax1tnir#3=6k0)nib)!^_g!()pdvg2iuri$-(l*

# Production mode settings
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,www.your-domain.com

# Environment identifier
ENVIRONMENT=production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Option A: PostgreSQL (RECOMMENDED for production)
# Uncomment and configure for PostgreSQL deployment
# DATABASE_URL=postgresql://username:password@localhost:5432/ts_opac_elibrary

# Option B: SQLite (Simple, suitable for testing/small deployments)
# Uncomment for SQLite deployment (database file will be created in project root)
DATABASE_URL=sqlite:///db.sqlite3

# Database connection timeout (seconds)
DB_CONN_MAX_AGE=600

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# HTTPS/SSL Configuration
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_SECURITY_POLICY=True
X_FRAME_OPTIONS=DENY

# HSTS Configuration (HTTP Strict Transport Security)
# Seconds to enforce HTTPS (31536000 = 1 year)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ALLOW_CREDENTIALS=True

# Cookie settings
SESSION_COOKIE_AGE=1209600
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================

# Email backend (for notifications, password reset, etc.)
# Options: django.core.mail.backends.smtp.EmailBackend (production)
#          django.core.mail.backends.console.EmailBackend (development)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Server Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Default email address for system notifications
DEFAULT_FROM_EMAIL=noreply@your-domain.com
SERVER_EMAIL=server@your-domain.com

# ============================================================================
# SENTRY ERROR TRACKING (Optional)
# ============================================================================

# Sentry DSN for error tracking and monitoring
# Get from https://sentry.io/
# Leave empty to disable Sentry
SENTRY_DSN=

# Sentry environment identifier
SENTRY_ENVIRONMENT=production

# Sentry trace sample rate (0.0 to 1.0, where 1.0 = 100%)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================

# Cache backend (in-memory or Redis)
# Options:
#   django.core.cache.backends.locmem.LocMemCache (in-memory, single process)
#   django.core.cache.backends.redis.RedisCache (distributed, recommended)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# Redis configuration (if using Redis cache)
# REDIS_URL=redis://:password@localhost:6379/0
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://localhost:6379/0

# Cache timeout (seconds)
CACHE_TIMEOUT=3600

# ============================================================================
# CELERY CONFIGURATION (Optional - for background tasks)
# ============================================================================

# Celery broker (message queue)
# Options: redis://, amqp://, etc.
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Celery timezone
CELERY_TIMEZONE=UTC

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file location (production)
# Create logs directory if needed
LOG_FILE=/var/log/ts-opac-elibrary/django.log

# ============================================================================
# API CONFIGURATION
# ============================================================================

# API rate limiting (requests per minute)
API_RATE_LIMIT=100

# API timeout (seconds)
API_TIMEOUT=30

# API pagination default page size
API_PAGE_SIZE=20

# ============================================================================
# STATIC & MEDIA FILES
# ============================================================================

# Static files directory (for collectstatic)
STATIC_URL=/static/
STATIC_ROOT=/var/www/ts-opac-elibrary/static/

# Media files directory (for uploads)
MEDIA_URL=/media/
MEDIA_ROOT=/var/www/ts-opac-elibrary/media/

# ============================================================================
# MAINTENANCE MODE (Optional)
# ============================================================================

# Set to True to enable maintenance mode (returns 503 Service Unavailable)
MAINTENANCE_MODE=False
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_STORAGE_BUCKET_NAME=your-bucket-name

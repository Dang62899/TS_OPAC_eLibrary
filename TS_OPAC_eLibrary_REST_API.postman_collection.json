        {
          "name": "1.1 Register User",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"newuser\",\"email\":\"user@example.com\",\"password\":\"SecurePass123!\",\"password_confirm\":\"SecurePass123!\",\"first_name\":\"John\",\"last_name\":\"Doe\"}"
            },
            "url": {"raw": "http://localhost:8000/api/v1/auth/register/", "protocol": "http", "host": ["localhost"], "port": "8000", "path": ["api", "v1", "auth", "register", ""]}
          }
        },
        {
          "name": "1.2 Get Auth Token",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"admin\",\"password\":\"admin\"}"

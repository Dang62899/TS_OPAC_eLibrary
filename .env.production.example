# TS OPAC eLibrary - Production Environment Configuration
# 
# Copy this file to .env.production and update all values
# NEVER commit .env.production to version control
# NEVER share these values in emails or chat

# ============================================================================
# DJANGO CONFIGURATION
# ============================================================================

# Settings module for production
DJANGO_SETTINGS_MODULE=elibrary.settings_production

# CRITICAL: Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Must be at least 50 characters and unique for each deployment
DJANGO_SECRET_KEY=change-me-with-strong-random-key-at-least-50-chars

# Environment identifier
ENVIRONMENT=production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL database name
DB_NAME=elibrary

# PostgreSQL user
DB_USER=elibrary

# PostgreSQL password (strong password recommended)
DB_PASSWORD=change-me-to-strong-password

# PostgreSQL host (use 'db' for Docker, 'hostname' for VM)
DB_HOST=db

# PostgreSQL port
DB_PORT=5432

# Enable SSL for database connection (true/false)
DB_SSL=False

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# SMTP host (Gmail: smtp.gmail.com, Outlook: smtp-mail.outlook.com)
EMAIL_HOST=smtp.gmail.com

# SMTP port (Gmail/Outlook: 587)
EMAIL_PORT=587

# Use TLS (true for most providers)
EMAIL_USE_TLS=True

# Email account username
EMAIL_HOST_USER=your-email@gmail.com

# Email account password or app password (for Gmail, use App Password)
# See: https://support.google.com/accounts/answer/185833
EMAIL_HOST_PASSWORD=your-app-password-16-chars

# Default from email address
DEFAULT_FROM_EMAIL=noreply@yourlibrary.com

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================

# Redis connection URL
# For Docker: redis://redis:6379/1
# For local: redis://localhost:6379/1
# For managed: redis://:password@host:port/1
REDIS_URL=redis://redis:6379/1

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Directory for log files (must be writable by container)
LOG_DIR=/var/log/elibrary

# Django logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO

# Enable SQL query logging in development (true/false)
DEBUG_SQL=False

# ============================================================================
# SENTRY ERROR TRACKING
# ============================================================================

# Sentry DSN for error tracking (leave empty to disable)
# Get from: https://sentry.io
# Example: https://key@sentry.io/project-id
SENTRY_DSN=

# Sentry traces sample rate (0.0 to 1.0, 0.1 = 10%)
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# SECURITY & ALLOWED HOSTS
# ============================================================================

# Comma-separated list of allowed domains
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ============================================================================
# SSL/TLS CERTIFICATE PATHS
# ============================================================================

# Path to SSL certificate file (inside container)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem

# Path to SSL private key file (inside container)
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ============================================================================
# API RATE LIMITING
# ============================================================================

# Anonymous user rate limit (requests/time period)
# Example: 100/hour, 10/minute
API_THROTTLE_ANON=100/hour

# Authenticated user rate limit
API_THROTTLE_USER=1000/hour

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# API pagination size
API_PAGE_SIZE=20

# Session timeout (seconds)
# 1800 = 30 minutes
SESSION_TIMEOUT=1800

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

# Backup directory (must exist and be writable)
BACKUP_DIR=/backups

# Keep backups for how many days
BACKUP_RETENTION_DAYS=30

# ============================================================================
# MONITORING & HEALTH CHECKS
# ============================================================================

# Enable health check endpoints (true/false)
ENABLE_HEALTH_CHECKS=true

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================

# Docker Compose profile (don't change unless using profiles)
COMPOSE_PROFILES=

# Container restart policy (always, unless-stopped, on-failure, no)
RESTART_POLICY=unless-stopped

# ============================================================================
# NOTES
# ============================================================================

# 1. SECRETS MANAGEMENT
#    - Store this file in a secrets manager (Vault, AWS Secrets Manager)
#    - Rotate secrets regularly
#    - Never commit to version control
#
# 2. EMAIL SETUP (Gmail Example)
#    - Enable 2-factor authentication
#    - Generate "App Password": https://support.google.com/accounts/answer/185833
#    - Use app password in EMAIL_HOST_PASSWORD
#
# 3. SSL CERTIFICATES
#    - Use Let's Encrypt for free certificates: https://letsencrypt.org/
#    - Set up auto-renewal with certbot
#    - Store in ssl/ directory
#
# 4. SECURITY
#    - Change all default values
#    - Use strong passwords (>16 characters)
#    - Enable 2FA where available
#    - Rotate credentials quarterly
#
# 5. MONITORING
#    - Set up Sentry for error tracking
#    - Configure log aggregation
#    - Set up monitoring alerts
#
# 6. BACKUPS
#    - Test backup restoration regularly
#    - Store backups off-site
#    - Encrypt backups
#
# 7. UPDATES
#    - Keep dependencies updated
#    - Test updates in staging first
#    - Review security advisories regularly

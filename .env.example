# ================================================================
# TS OPAC eLibrary - Environment Configuration Template
# ================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ================================================================
# DJANGO SETTINGS
# ================================================================

# Secret key for Django (generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
ELIBRARY_SECRET_KEY=your-django-secret-key-change-in-production

# Debug mode (True for development, False for production)
ELIBRARY_DEBUG=True

# Allowed hosts (comma-separated, for production use your domain)
ELIBRARY_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,*.herokuapp.com

# Production mode flag
ELIBRARY_PRODUCTION=False

# ================================================================
# DATABASE CONFIGURATION
# ================================================================

# SQLite (for development)
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/elibrary_db
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# MySQL (alternative)
# DATABASE_URL=mysql://user:password@localhost:3306/elibrary_db

# ================================================================
# EMAIL CONFIGURATION (for notifications)
# ================================================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Default from email
DEFAULT_FROM_EMAIL=noreply@elibrary.local

# ================================================================
# REDIS CONFIGURATION (for caching & Celery)
# ================================================================

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ================================================================
# SECURITY SETTINGS (Production)
# ================================================================

# HTTPS/SSL settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Referrer policy
SECURE_REFERRER_POLICY=no-referrer-when-downgrade

# ================================================================
# CORS CONFIGURATION
# ================================================================

# Allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://yourdomain.com

# ================================================================
# API CONFIGURATION
# ================================================================

# API throttling (requests per hour)
API_ANON_RATE_LIMIT=100/hour
API_USER_RATE_LIMIT=1000/hour

# Pagination
API_PAGE_SIZE=20

# ================================================================
# ERROR TRACKING (Sentry)
# ================================================================

# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ================================================================
# FILE UPLOADS
# ================================================================

# Max file upload size (in bytes, default 10MB)
MAX_UPLOAD_SIZE=10485760

# Allowed file extensions for covers
ALLOWED_COVER_EXTENSIONS=jpg,jpeg,png,gif,webp

# ================================================================
# LOGGING
# ================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file location
LOG_FILE=logs/elibrary.log

# ================================================================
# THIRD-PARTY SERVICES
# ================================================================

# AWS S3 (for file storage)
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_STORAGE_BUCKET_NAME=your-bucket
# AWS_S3_REGION_NAME=us-east-1

# Cloudinary (for image hosting)
# CLOUDINARY_CLOUD_NAME=your-cloud
# CLOUDINARY_API_KEY=your-key
# CLOUDINARY_API_SECRET=your-secret

# ================================================================
# DEPLOYMENT (Heroku/Railway)
# ================================================================

# Python version
PYTHON_RUNTIME=python-3.11.0

# Procfile will be deployed
# WEB_CONCURRENCY=4

# ================================================================
# DEVELOPMENT TOOLS
# ================================================================

# Django Debug Toolbar
DEBUG_TOOLBAR_ENABLED=False

# Testing
TEST_RUNNER=django.test.runner.DiscoverRunner
